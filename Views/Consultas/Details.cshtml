@model GestaoConsultasUVV.Models.Consulta
@{
    ViewData["Title"] = "Detalhes da consulta";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="h3 mb-4">Detalhes da consulta</h1>

        <dl class="row">
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Especialidade)</dt>
            <dd class="col-sm-8">@Model.Especialidade</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.DataHora)</dt>
            <dd class="col-sm-8">@Model.DataHora.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Descricao)</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Descricao) ? "-" : Model.Descricao)</dd>
        </dl>

        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
    </div>
</div>
